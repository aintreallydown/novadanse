{% extends 'layouts/base.html.twig' %}


{% block title %}Galerie photos | Nøva Danse{% endblock %}

{% block meta_description %}Nos histoires en images : découvrez la galerie photos de Nøva Danse à Estrées-Saint-Denis, entre éveil, création et partage du mouvement, pour tous les âges.{% endblock %}

{% block meta_image %}{{ absolute_url(asset('images/nova-hero_section.jpg')) }}{% endblock %}


{% block body %}


    {% include 'partials/nav.html.twig' %}

    <section class="gallery-hero relative">
        <span class="eyebrow">Galerie</span>
        <h1 class="cormorant-garamond">Nos histoires<br> en images</h1>
        <p class="p-25"><i>Quelques instants volés aux cours, aux répétitions<br> et aux spectacles de NØVA.</i></p>
    </section>

    <section id="gallery-enfants" class="relative gallery-section">
        <div class="gallery-section__head">
            <span class="eyebrow">Eveil 4 - 6 ans</span>
            {# <div class="relative flex">
                <ul class="naked-list">
                    <li> Mercredi</li>
                    <li> 17h - 17h45</li>
                    <li> Salle multisport</li>
                </ul>
                <ul class="naked-list">
                    <li> Mercredi</li>
                    <li> 18h - 18h45</li>
                    <li> Salle multisport</li>
                </ul>
            </div> #}
            <h2 class="cormorant-garamond">Découvrir le mouvement<br> avec curiosité</h2>
        </div>
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/eveil/ballerine.jpg') }}" alt="Jeune danseuse en tenue de ballerine, cours d'éveil NØVA Danse" title="Jeune danseuse en tenue de ballerine, cours d'éveil NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/eveil/ecoute.jpg') }}" alt="Enfants à l'écoute pendant un cours d'éveil à chez NØVA danse" title="Enfants à l'écoute pendant un cours d'éveil à chez NØVA danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/eveil/inspiration.jpg') }}" alt="Moment d'inspiration artistique en cours d'éveil chez NØVA Danse" title="Moment d'inspiration artistique en cours d'éveil chez NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/eveil/scene.jpg') }}" alt="Enfants sur scène lors d'un spectacle du cours d'éveil NØVA Danse" title="Enfants sur scène lors d'un spectacle du cours d'éveil NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/eveil/repetition.jpg') }}" alt="Répétition d'un cours d'éveil à la danse chez NØVA Danse" title="Répétition d'un cours d'éveil à la danse chez NØVA Danse">
            </figure>
            
        </div>
    </section>

    <section id="gallery-ados-adultes" class="relative gallery-section gallery-section--alt">
        <div class="gallery-section__head">
            <span class="eyebrow">Initiation : 7 - 10 ans</span>
            <h2 class="cormorant-garamond">Imaginer, créer<br> explorer le mouvement</h2>
        </div>
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/initiation/scene.jpg') }}" alt="Spectacle du cours d'initiation à la danse NØVA, 7-10 ans" title="Spectacle du cours d'initiation à la danse NØVA, 7-10 ans">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/initiation/preparation.jpg') }}" alt="Préparation avant un spectacle du cours d'initiation NØVA Danse" title="Préparation avant un spectacle du cours d'initiation NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/initiation/spectacle.jpg') }}" alt="Spectacle de danse du cours d'initiation chez NØVA Danse" title="Spectacle de danse du cours d'initiation chez NØVA Danse">
            </figure>
        </div>
    </section>

    <section id="gallery-spectacles" class="relative gallery-section">
        <div class="gallery-section__head">
            <span class="eyebrow">Ados 11 - 15 ans</span>
            <h2 class="cormorant-garamond">Trouvez sa voix<br> à travers le mouvement</h2>
        </div>
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/ados/spectacle-1.jpg') }}" alt="Spectacle de danse des ados chez NØVA Danse" title="Spectacle de danse des ados chez NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/ados/repetition.jpg') }}" alt="Répétition du cours de danse ados chez NØVA Danse" title="Répétition du cours de danse ados chez NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/ados/spectacle.jpg') }}" alt="Représentation scénique du cours de danse ados NØVA" title="Représentation scénique du cours de danse ados NØVA">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/ados/ballerine.jpg') }}" alt="Jeune danseuse ado lors d'un spectacle NØVA Danse" title="Jeune danseuse ado lors d'un spectacle NØVA Danse">
            </figure>

           
        </div>
    </section>

    <section id="gallery-coulisses" class="relative gallery-section gallery-section--alt">
        <div class="gallery-section__head">
            <span class="eyebrow">Danse d'expression : + 15 ans</span>
            <h2 class="cormorant-garamond">Créer, ressentir<br> partager</h2>
        </div>
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/expression/spectacle.jpg') }}" alt="Spectacle du cours de danse d'expression chez NØVA Danse" title="Spectacle du cours de danse d'expression chez NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/expression/spectacle-1.jpg') }}" alt="Représentation du cours de danse d'expression NØVA Danse" title="Représentation du cours de danse d'expression NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/expression/salutation.jpg') }}" alt="Salut final d'un spectacle de danse d'expression NØVA Danse" title="Salut final d'un spectacle de danse d'expression NØVA Danse">
            </figure>
        </div>
    </section>

    <section id="gallery-vie-associative" class="relative gallery-section">
        <div class="gallery-section__head">
            <span class="eyebrow">Danse &amp; bien-être</span>
            <h2 class="cormorant-garamond">Habiter son corps<br> autrement</h2>
        </div>
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/bien_etre/aurelie.jpg') }}" alt="Aurélie animant un cours de danse et bien-être chez NØVA Danse" title="Aurélie animant un cours de danse et bien-être chez NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/bien_etre/danse.jpg') }}" alt="Cours de danse et bien-être pour adultes chez NØVA Danse" title="Cours de danse et bien-être pour adultes chez NØVA Danse">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/bien_etre/joie.jpg') }}" alt="Moment de joie pendant un cours de danse et bien-être NØVA" title="Moment de joie pendant un cours de danse et bien-être NØVA">
            </figure>
            <figure class="gallery-item">
                <img loading="lazy" src="{{ asset('images/galerie/bien_etre/sourire.jpg') }}" alt="Sourires pendant un cours de danse et bien-être chez NØVA Danse" title="Sourires pendant un cours de danse et bien-être chez NØVA Danse">
            </figure>
        </div>
    </section>

    {% include 'partials/footer.html.twig' %}

{% endblock %}
