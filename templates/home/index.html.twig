{% extends 'layouts/base.html.twig' %}


{% block title %}Accueil - Nøva danse{% endblock %}



{% block body %}


    {% include 'partials/nav.html.twig' %}
    
    <section class="relative w-100 hero-section">
        
        <figure>
            <img src="{{ asset('images/nova-hero_section.png') }}" alt="Image d'accueil">
        </figure>

        <h1> Se dire en<br> mouvement<br> s'unir en <br> dansant</h1>
        
        <button class="btn">Découvrir</button>

    </section>

    <section id="notre-histoire" class="relative flex">
        
        <div>
            <h2>Certaines <br> histoires <br> semblent écrites <br> d’avance</h2>
            <p><i>La danse est un langage. Une manière de se<br> raconter, de se rencontrer.</i></p>

            <button class="uppercase">Notre histoire <i class="fa-solid fa-arrow-turn-up color-gray"></i></button>
            <button class="uppercase">Notre vision <i class="fa-solid fa-arrow-turn-up color-gray"></i></button>

        </div>

        <img src="{{ asset('images/nova-h2_section.png') }}" alt="Image d'accueil">
    </section>
    <section id="nos-cours" class="relative flex space-between">
        <div>
            <h2>Chaque <br> histoire <br>commence <br> par un <br>premier pas</h2>
            <figure>
                <img src="{{ asset('images/nova-cours1.png') }}" alt="Image d'accueil">
                <figcaption><strong>Eveils 4-6 ans: découvrir le mouvement avec curiosité</strong></figcaption>
            </figure>
        </div>
        <div>
            <figure>
                <img src="{{ asset('images/nova-cours2.png') }}" alt="Image d'accueil">
                <figcaption><strong>Initiation 7-10 ans: imaginer, créer, explorer le mouvement</strong></figcaption>
            </figure>
        </div>
        <div>
            <figure>
                <img src="{{ asset('images/nova-cours3.png') }}" alt="Image d'accueil" style="width: 100%; height: 100%;">
                <figcaption><strong>Ados 11-15 ans: trouver sa voix à travers le mouvement</strong></figcaption>
            </figure>
        </div>
    </section>
    <section id="chapitre" class="relative flex">
        <figure>
            <img src="{{ asset('images/nova-chapitre.png') }}" alt="Image d'accueil">
        </figure>

        <div>
            <h2>D’autres histoires<br> méritent un<br> nouveau<br> chapitre</h2>
            <div class="flex p-25">
                <h3><i>
                    Adultes danse d’expression:<br>
                        créer, ressentir, partager
                </i></h3>
                <span></span>
                <h3><i>
                    Adultes danse et bien être: <br>
                        habiter son corps autrement
                </i></h3>
            </div>
        </div>
    </section>


{% endblock %}

