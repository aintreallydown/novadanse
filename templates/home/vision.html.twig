{% extends 'layouts/base.html.twig' %}

{% block title %}Notre vision | Nøva Danse{% endblock %}

{% block meta_description %}Découvrez la vision de Nøva Danse (Estrées-Saint-Denis) : se dire, créer et habiter son corps à travers le mouvement. Une pédagogie de la danse centrée sur l'épanouissement de chacun.{% endblock %}

{% block body %}


    {% include 'partials/nav.html.twig' %}

    <section class="hero-section-vision relative">
        
        <figure>
            <img loading="lazy" src="{{ asset('images/hero-vision.png') }}" alt="La vision de NØVA Danse : la danse comme langage et moyen d'expression" title="La vision de NØVA Danse : la danse comme langage et moyen d'expression">
        </figure>

        <div class="flex relative">

            <h1> Notre vision</h1>
            
            <p>
            Chez NØVA, nous ne pensons pas que la danse soit une fin en soi. Nous la voyons comme un langage, 
            un espace de création et une manière de se rencontrer, de grandir et de prendre soin de soi.
            </p>
        </div>

    </section>

    <section id="technique" class="relative flex">
        <h2>
            La technique donne des outils.
            L'expression leur donne du sens.
        </h2>

    </section>
    <hr class="mobile" style="width: 80%; margin: 0 auto; border: 1px solid #000;">
    <section id="se-dire" class="relative flex">
        <figure class="p-25 hide">
            <img loading="lazy" src="{{ asset('images/dire-section.png') }}" alt="Se dire à travers la danse, chaque corps a une histoire à raconter chez NØVA Danse" title="Se dire à travers la danse, chaque corps a une histoire à raconter chez NØVA Danse">
        </figure>

        <div>
            <h2 class="p-25 cormorant-garamond ">Se dire</h2>
            <div class="">
                <p>
                    Nous croyons que chaque corps possède déjà quelque chose à raconter.
                    La danse n'a pas pour objectif de faire entrer chacun dans un modèle.
                    Elle permet au contraire de découvrir sa propre manière d'<strong>habiter le mouvement</strong>.
                </p>
            </div>
        </div>

    </section>
    <hr class="mobile" style="width: 80%; margin: 0 auto; border: 1px solid #000;">
    <section id="se-dire" class="relative flex row-reverse">
        <figure class="p-25 hide">
            <img loading="lazy" src="{{ asset('images/creer.png') }}" alt="Processus de création artistique des spectacles NØVA Danse" title="Processus de création artistique des spectacles NØVA Danse">
        </figure>

        <div>
            <h2 class="p-25 cormorant-garamond ">Créer</h2>
            <div class="">
                <p>
                    Nos spectacles commencent toujours par une <strong>histoire</strong>.
                    Les élèves explorent, improvisent, cherchent.
                    Leurs propositions nourrissent le processus de création avant d'être réunies dans une direction artistique commune.

                </p>
            </div>
        </div>
    </section>

    <hr class="mobile" style="width: 80%; margin: 0 auto; border: 1px solid #000;">

    <section id="se-dire" class="relative flex">
        <figure class="p-25 hide">
            <img loading="lazy" src="{{ asset('images/habiter.png') }}" alt="Habiter son corps à travers le mouvement chez NØVA Danse" title="Habiter son corps à travers le mouvement chez NØVA Danse">
        </figure>

        <div>
            <h2 class="p-25 cormorant-garamond ">Habiter son corps</h2>
            <div class="">
                <p>
                Respirer.
                Ressentir.
                Retrouver de la mobilité.
                Se reconnecter à ses sensations.
                <strong>Découvrir</strong> qu'un mouvement peut parfois faire autant de bien qu'un mot.


                </p>
            </div>
        </div>
    </section>
    <section class="bottom-section  relative">
        
        <figure>
            <img loading="lazy" src="{{ asset('images/ballerine.jpg') }}" class="w-100" alt="Danseuse de NØVA Danse en mouvement" title="Danseuse de NØVA Danse en mouvement">
        </figure>

        <button class="glass btn">
            <a href="/#adhesion" class="btn">Rejoignez nous</a>
        </button>

        <svg style="display:none">
            <filter id="lg" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="92" result="noise"/>
                <feGaussianBlur in="noise" stdDeviation="2" result="blurredNoise"/>
                <feDisplacementMap in="SourceGraphic" in2="blurredNoise" scale="60" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
        </svg>

    </section>
{% include 'partials/footer.html.twig' %}

{% endblock %}